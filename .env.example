# Database Connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEMO_SEED=true
# Keep false/omitted in production. Demo seed is for local development only.

# Marketing & Conversion Tracking (Meta Pixel & Google Ads)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# ==============================================================================
# Meta WhatsApp Cloud API (Graph API v21.0)
# ==============================================================================
# From Meta App Dashboard > WhatsApp > API Setup:
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Webhook verification token entered in Meta Webhook configuration:
WHATSAPP_VERIFY_TOKEN=janaseva_waba_webhook_verify_secure_token_2026
# App Secret from Meta App Dashboard > App settings > Basic (for HMAC-SHA256 signature verification):
WHATSAPP_APP_SECRET=
# Graph API Version (defaults to v21.0)
META_GRAPH_API_VERSION=v21.0

# ==============================================================================
# AI Chatbot & Copilot (Google Gemini API)
# ==============================================================================
GEMINI_API_KEY=
